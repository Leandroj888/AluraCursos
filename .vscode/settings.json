{
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "workbench.startupEditor": "newUntitledFile",
    //"window.zoomLevel": -1.5,
    "editor.formatOnSave": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true,
        "**/vendor/*/**": true
    },
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    // PHP
    // Here you can use your path to php
    "php.validate.executablePath": "/usr/bin/php8.1",
    "php.suggest.basic": false,
    "phpSniffer.run": "onType",
    "phpSniffer.autoDetect": true,
    // Here you can use another coding-style
    "phpSniffer.standard": "PSR12",
    "[php]": {
        "editor.defaultFormatter": "wongjn.php-sniffer"
    },
    "commentTranslate.source": "Google",
    "commentTranslate.multiLineMerge": false,
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "/home/leju/.sdkman/candidates/java/21-tem",
            "default": true
        }
    ],
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.maven.enabled": true,
    "java.templates.newFile.enabled": true,
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnSave": true
    }
}
